# ─────────────────────────────────────────────────────────
# SIH26124 Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────

# SQLite database file path (relative to /backend)
DATABASE_URL="file:./dev.db"

# Port for the Express server
PORT=5000

# JWT secret key — change this to a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this

# JWT expiry duration
JWT_EXPIRES_IN=7d

# ─── AI Service ───────────────────────────────────────────
# When your teammate's Python YOLO model is ready,
# set this URL to their Flask/FastAPI server address.
# While it's not ready, the backend uses the built-in mock.

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_ENABLED=false

# ─── File Storage ─────────────────────────────────────────
# Base URL used to build image URLs returned in API responses
BASE_URL=http://localhost:5000
